# detect faces and add markers to key landmarks on the face
import cv2
import mediapipe as mp
import os

# funciton to open the webcam
def open_webcam():
    cap = cv2.VideoCapture(0)
    
    if not cap.isOpened():
        print("Error: Could not open webcam.")
        return None

    return cap

# function to close the webcam
def close_webcam(cap):
    cap.release()
    cv2.destroyAllWindows()

# function to capture a single frame from the webcam
def capture_frame(cap):
    ret, frame = cap.read()
    if not ret:
        print("Failed to grab frame.")
        return None
    return frame



