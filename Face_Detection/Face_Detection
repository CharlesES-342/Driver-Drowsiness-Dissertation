# get image
def getImage(image_path):
    image = cv2.imread(image_path)
    if image is None:
        raise FileNotFoundError(f"Could not read the image at {image_path}")
    return image

# process image
def processImage(image):
    rgb_image = cv2.cvtColor(image, cv2.COLOR_BGR2RGB)

    # add the face mesh instance
    with mp_face_mesh.FaceMesh(
        static_image_mode=True,
        max_num_faces=1,
        refine_landmarks=True,
        min_detection_confidence=0.5
    ) as face_mesh:
        results = face_mesh.process(rgb_image)

    # draw on lardmarks I am interested in
    annotated_image = image.copy()

    if results.multi_face_landmarks: #if there is a face in the image
        for face_landmarks in results.multi_face_landmarks: #loop through all detected faces in the image
            #draw mesh partterns
            mp_drawing.draw_landmarks(
            image=annotated_image,
            landmark_list=face_landmarks,
            connections=mp_face_mesh.FACEMESH_TESSELATION,
            landmark_drawing_spec=None,
            connection_drawing_spec=mp_styles.get_default_face_mesh_tesselation_style()
            )
            
            #draw contour features (face outline, eye outline, mouth outline...)
            mp_drawing.draw_landmarks(
            image=annotated_image,
            landmark_list=face_landmarks,
            connections=mp_face_mesh.FACEMESH_CONTOURS,
            landmark_drawing_spec=None,
            connection_drawing_spec=mp_styles.get_default_face_mesh_contours_style()
            )   

        # --- store all face landmarks --- TODO: only store the ones I need
            landmarks = face_landmarks.landmark

            
        # --- extract key landmarks from the image ---
            # eye openness for blinking and closed eyes detection
            left_eye_height = abs(get_pixel_coords(keyLandmarks["left_eye_bottom"])[1] - get_pixel_coords(keyLandmarks["left_eye_top"])[1])
            right_eye_height = abs(get_pixel_coords(keyLandmarks["right_eye_bottom"])[1] - get_pixel_coords(keyLandmarks["right_eye_top"])[1])
            # mouth corners for yawning detection
            mouth_top_lip = get_pixel_coords(keyLandmarks["upper_lip"])
            mouth_bottom_lip = get_pixel_coords(keyLandmarks["lower_lip"])
            mouth_height = abs(mouth_bottom_lip[1] - mouth_top_lip[1])
            # head angle for nodding detection
            nose_tip = get_pixel_coords(keyLandmarks["nose_tip"])
            forehead = get_pixel_coords(keyLandmarks["forehead"])
            dx = forehead[0] - nose_tip[0] #tilting head left or right
            dy = forehead[1] - nose_tip[1] #tilting head up or down


        # --- drawing on the image for testing purposes ---
            font = cv2.FONT_HERSHEY_SIMPLEX
            font_scale = 0.6
            color = (0, 255, 0)
            thickness = 2

        # --- displaying values on the image ---
            # font and text outline settings
            font = cv2.FONT_HERSHEY_SIMPLEX
            font_scale = 0.6
            color = (0, 255, 0)
            thickness = 1
            # display the text
            cv2.putText(annotated_image, f"Left eye height: {left_eye_height}px", (30, 30), font, font_scale, color, thickness)
            cv2.putText(annotated_image, f"Right eye height: {right_eye_height}px", (30, 60), font, font_scale, color, thickness)
            cv2.putText(annotated_image, f"Mouth height: {mouth_height}px", (30, 90), font, font_scale, color, thickness)
            cv2.putText(annotated_image, f"change in x: {dx}px", (30, 120), font, font_scale, color, thickness)
            cv2.putText(annotated_image, f"change in y: {dy}px", (30, 150), font, font_scale, color, thickness)
    else:
        print("No face detected.")

    #  --- display result ---
    cv2.imshow("Face Landmarks", annotated_image)
    cv2.waitKey(0)
    cv2.destroyAllWindows()


